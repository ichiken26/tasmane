# Copy to .env and fill real values. Never commit .env.

# --- Shared ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Worker Binding secret (same value on Worker + Go API). >= 32 chars.
TASMANE_INTERNAL_BINDING_SECRET=
NUXT_INTERNAL_BINDING_SECRET=

# Impact confirmation token HMAC secret. >= 32 chars. Distinct from binding secret.
TASMANE_IMPACT_TOKEN_SECRET=

# AES-256-GCM key for Google refresh tokens.
# API requires standard Base64 of exactly 32 raw bytes:
#   openssl rand -base64 32
TASMANE_GOOGLE_TOKEN_ENCRYPTION_KEY=

# Container / private host listen address. Local default in code is 127.0.0.1:8080.
TASMANE_HTTP_ADDR=0.0.0.0:8080

# --- Google OAuth (Worker login + Tasks worker) ---
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_GOOGLE_REDIRECT_URI=https://tasmane.kokage-studio.com/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Session cookie seal secret for Worker. >= 32 chars.
NUXT_SESSION_SECRET=

# Browser API base (SPEC: /api/*). Keep /v1 only for local experiments.
NUXT_PUBLIC_API_BASE=/api/v1

# Local-only fallback when Service Binding is absent.
NUXT_API_INTERNAL_URL=http://127.0.0.1:8080

# --- Gemini (advice-scheduler) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Optional MCP process ---
TASMANE_MCP_USER_ID=

# --- Toolchain (local verify) ---
TASMANE_GO_BIN=
GOFLAGS=-buildvcs=false
