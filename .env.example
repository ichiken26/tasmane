# 自宅サーバー（docker-compose.prod.yml）用。.env にコピーして実値を入れる。Git に入れない。
# Worker 側のシークレットは secrets/worker.env（下記 secrets/worker.env.example）へ。

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# --- Worker ↔ Go API 共有シークレット（secrets/worker.env の NUXT_INTERNAL_BINDING_SECRET と同値。32文字以上） ---
TASMANE_INTERNAL_BINDING_SECRET=

# Impact Token HMAC 鍵（32文字以上。他の鍵と別値）
TASMANE_IMPACT_TOKEN_SECRET=

# Google refresh token 暗号化鍵（32 raw bytes の標準Base64: openssl rand -base64 32）
TASMANE_GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Cloudflare Tunnel（npm run setup:cloudflare で取得） ---
TASMANE_TUNNEL_TOKEN=
# Tunnel 用ネットワーク（Workers VPC Service の宛先 IP と一致させる）
TASMANE_TUNNEL_SUBNET=172.29.80.0/24
TASMANE_API_TUNNEL_IP=172.29.80.10

# --- Google Tasks 同期ワーカー（Worker と同じ OAuth クライアントで可） ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Gemini（advice-scheduler） ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- 任意: stdio MCP プロセス（ローカルの MCP クライアントから使う場合） ---
TASMANE_MCP_USER_ID=

# --- ローカル開発（nuxt dev）用 ---
NUXT_API_INTERNAL_URL=http://127.0.0.1:8080
