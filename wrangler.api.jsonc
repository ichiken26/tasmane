{
    "$schema": "node_modules/wrangler/config-schema.json",
  
    "name": "tasmane-api",
    "main": "cloudflare/api/index.ts",
  
    "compatibility_date": "2026-08-15",
  
    // Go API自体をInternetへ直接出さない
    "workers_dev": false,
    "preview_urls": false,
  
    "containers": [
      {
        "class_name": "TasmaneApiContainer",
        "image": "./Dockerfile",
        "image_build_context": ".",
        "max_instances": 1,
        "instance_type": "lite"
      }
    ],
  
    "durable_objects": {
      "bindings": [
        {
          "name": "API_CONTAINER",
          "class_name": "TasmaneApiContainer"
        }
      ]
    },
  
    "migrations": [
      {
        "tag": "v1",
        "new_sqlite_classes": ["TasmaneApiContainer"]
      }
    ],
  
    "observability": {
      "enabled": true
    }
  }