# cf deploy --secrets-file 用（tasmane-web の Worker Secrets）。worker.env にコピーして実値を入れる。Git に入れない。
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_GOOGLE_REDIRECT_URI=https://tasmane.kokage-studio.com/auth/callback
# 32文字以上
NUXT_SESSION_SECRET=
# 自宅サーバー .env の TASMANE_INTERNAL_BINDING_SECRET と同値
NUXT_INTERNAL_BINDING_SECRET=
