{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasmane-web",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  // Public hostname is attached in the Cloudflare dashboard (or via routes below).
  // "routes": [{ "pattern": "tasmane.kokage-studio.com/*", "zone_name": "kokage-studio.com" }],
  "services": [
    {
      // Must resolve to the private Go API Worker/Tunnel service in the same account.
      "binding": "TASMANE_API",
      "service": "tasmane-api"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
