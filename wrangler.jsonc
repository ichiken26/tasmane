{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasmane-web",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "TASMANE_API",
      "service": "tasmane-api"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
